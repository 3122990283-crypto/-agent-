# ============================================================
# 信贷材料预审 Agent · 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Key
# ============================================================

# ---------- OCR API（飞桨 PaddleOCR-VL 1.6） ----------
# 申请地址：https://aistudio.baidu.com/
PADDLE_OCR_TOKEN=your_paddle_ocr_token_here

# ---------- LLM API（阿里云千问 DashScope） ----------
# 申请地址：https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here

# ---------- 可选配置 ----------
# DATASET_ROOT=./数据集
# AUTO_PASS_THRESHOLD=0.9
# MANUAL_REVIEW_THRESHOLD=0.6
